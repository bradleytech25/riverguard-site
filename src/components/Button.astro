---
/**
 * Brand buttons. 44px tall, 4px radius, weight 600, sentence case.
 * `primary` is Signal amber — exactly ONE per view. The header uses `secondary`
 * so each page's hero or contact block owns the single primary.
 */
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'tertiary' | 'on-dark' | 'on-dark-outline';
  class?: string;
}
const { href, variant = 'secondary', class: className = '' } = Astro.props;
---
<a href={href} class:list={['btn', `btn-${variant}`, className]}><slot /></a>

<style>
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    min-height: 44px; padding: 0 var(--rg-space-6);
    border-radius: var(--rg-radius-sm); border: 1px solid transparent;
    font: var(--rg-weight-semibold) 1rem / 1 var(--rg-font-sans);
    text-decoration: none; white-space: nowrap; cursor: pointer;
    transition: background-color var(--rg-duration-1) var(--rg-ease), color var(--rg-duration-1) var(--rg-ease), border-color var(--rg-duration-1) var(--rg-ease);
  }
  @media (pointer: coarse) { .btn { min-height: 48px; } }
  .btn-primary { background: var(--rg-signal-600); color: var(--rg-text-on-fill); }
  .btn-primary:hover { background: var(--rg-signal-700); color: var(--rg-text-on-fill); }
  .btn-secondary { background: var(--rg-navy-900); color: var(--rg-text-on-fill); }
  .btn-secondary:hover { background: var(--rg-navy-800); color: var(--rg-text-on-fill); }
  .btn-tertiary { background: transparent; color: var(--rg-teal-700); border-color: var(--rg-border-strong); }
  .btn-tertiary:hover { color: var(--rg-teal-800); border-color: var(--rg-teal-700); background: var(--rg-teal-50); }
  .btn-on-dark { background: var(--rg-stone-0); color: var(--rg-navy-900); }
  .btn-on-dark:hover { background: var(--rg-navy-50); color: var(--rg-navy-900); }
  .btn-on-dark-outline { background: transparent; color: var(--rg-stone-0); border-color: var(--rg-stone-0); }
  .btn-on-dark-outline:hover { background: rgba(255,255,255,.1); color: var(--rg-stone-0); }
</style>
