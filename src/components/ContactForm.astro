---
/**
 * Formspree form. Labels above inputs, 44px fields, honeypot, no JS required.
 * Until `business.formspreeId` is set, shows a phone/email panel instead of a
 * dead form. On success Formspree redirects back here with ?sent=1.
 */
import Button from './Button.astro';
import Fact from './Fact.astro';
import { business, phoneHref, emailHref } from '../data/business';
const id = business.formspreeId;
const next = new URL('/contact?sent=1', Astro.site).href;
---
{id ? (
  <form class="form" action={`https://formspree.io/f/${id}`} method="POST" novalidate>
    <input type="hidden" name="_subject" value="New message from riverguard.solutions" />
    <input type="hidden" name="_next" value={next} />
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />

    <div class="row">
      <div class="field">
        <label for="name">Your name</label>
        <input id="name" name="name" type="text" required autocomplete="name" />
      </div>
      <div class="field">
        <label for="business">Business</label>
        <input id="business" name="business" type="text" autocomplete="organization" />
      </div>
    </div>
    <div class="row">
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email" />
      </div>
      <div class="field">
        <label for="phone">Phone <span class="opt">(optional)</span></label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" />
      </div>
    </div>
    <div class="field">
      <label for="message">What’s going on?</label>
      <textarea id="message" name="message" rows="5" required></textarea>
      <p class="hint">A sentence or two is plenty. We’ll reply with a real answer, not a form letter.</p>
    </div>
    <div class="actions">
      <button class="submit" type="submit">Send message</button>
      <p class="hint">Or call <a href={phoneHref}><Fact value={business.phone} /></a>.</p>
    </div>
  </form>
) : (
  <div class="panel">
    <h3>Get in touch</h3>
    <dl>
      <div><dt>Phone</dt><dd><a href={phoneHref}><Fact value={business.phone} /></a></dd></div>
      <div><dt>Email</dt><dd><a href={emailHref}><Fact value={business.email} /></a></dd></div>
      <div><dt>Hours</dt><dd><Fact value={business.hours} /></dd></div>
    </dl>
    <p>Tell us what’s going on in a sentence or two. You’ll get a real answer from a person, not a form letter.</p>
    <Button href={emailHref} variant="primary">Email us</Button>
  </div>
)}

<div class="sent" id="sent" hidden role="status">
  <strong>Thanks — your message is on its way.</strong> We’ll get back to you soon.
</div>

<style>
  .form { display: grid; gap: var(--rg-space-5); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--rg-space-5); }
  .field { display: grid; gap: var(--rg-space-2); }
  label { font-weight: var(--rg-weight-medium); color: var(--rg-text-strong); }
  .opt { color: var(--rg-text-faint); font-weight: var(--rg-weight-regular); }
  input, textarea {
    width: 100%; min-height: 44px; padding: var(--rg-space-3) var(--rg-space-4);
    font: inherit; color: var(--rg-text); background: var(--rg-stone-0);
    border: 1px solid var(--rg-border-strong); border-radius: var(--rg-radius-sm);
    transition: border-color var(--rg-duration-1) var(--rg-ease);
  }
  textarea { resize: vertical; }
  input:focus-visible, textarea:focus-visible { border-color: var(--rg-teal-700); box-shadow: var(--rg-shadow-focus); outline: none; }
  .hint { font-size: var(--rg-text-sm); color: var(--rg-text-muted); }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: var(--rg-space-5); margin-top: var(--rg-space-2); }
  .submit {
    display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 var(--rg-space-6);
    background: var(--rg-signal-600); color: var(--rg-text-on-fill); border: 1px solid transparent; border-radius: var(--rg-radius-sm);
    font: var(--rg-weight-semibold) 1rem / 1 var(--rg-font-sans); cursor: pointer;
    transition: background-color var(--rg-duration-1) var(--rg-ease);
  }
  .submit:hover { background: var(--rg-signal-700); }
  .panel { display: grid; gap: var(--rg-space-5); padding: var(--rg-space-8); background: var(--rg-stone-0); border: 1px solid var(--rg-border); border-radius: var(--rg-radius-md); }
  .panel h3 { font-size: var(--rg-text-xl); font-weight: var(--rg-weight-semibold); letter-spacing: 0; }
  .panel dl { margin: 0; display: grid; gap: var(--rg-space-3); }
  .panel dt { font-size: var(--rg-text-sm); font-weight: var(--rg-weight-semibold); letter-spacing: var(--rg-tracking-eyebrow); text-transform: uppercase; color: var(--rg-text-muted); }
  .panel dd { margin: 0; font-size: var(--rg-text-lg); }
  .panel p { color: var(--rg-text-muted); }
  .panel .btn { justify-self: start; }
  .sent { margin-top: var(--rg-space-6); padding: var(--rg-space-4) var(--rg-space-5); background: var(--rg-ok-50); border: 1px solid var(--rg-ok-100); color: var(--rg-ok-700); border-radius: var(--rg-radius-sm); }
  @media (max-width: 767px) { .row { grid-template-columns: 1fr; } }
</style>

<script>
  if (new URLSearchParams(location.search).get('sent') === '1') {
    const sent = document.getElementById('sent');
    if (sent) { sent.hidden = false; sent.scrollIntoView({ block: 'center' }); }
    document.querySelector<HTMLFormElement>('.form')?.reset();
  }
</script>
